# Poort waarop de server luistert
PORT=3000

# Zout voor de IP-hash. Zet hier een lange, willekeurige waarde.
# Let op: verander je dit zout, dan vervallen alle bestaande IP-blokkades.
IP_SALT=verander-dit-in-een-lange-willekeurige-string

# Token voor de admin-endpoints (statistiek en reset). Houd dit geheim.
ADMIN_TOKEN=verander-dit-ook

# Waar de kandidaat na de challenge naartoe gaat.
# Vul hier de echte URL in van het vacatureoverzicht, gefilterd op elektrotechniek.
VACATURE_URL=/vacatures

# Aantal seconden aftellen voordat de redirect volgt
REDIRECT_SECONDEN=5

# Aantal proxy-hops voor het bepalen van het client-IP.
# 0 = geen proxy (server staat direct aan het internet)
# 1 = achter nginx, Traefik of Cloudflare
TRUST_PROXY=0

# Pad naar het databasebestand
DB_PATH=./data/challenge.db

# Bewaartermijn voor sessies (voortgangstracking) in dagen.
# Sessies ouder dan dit worden automatisch opgeruimd, zodat de tabel niet
# oneindig groeit. Inzendingen (leads) blijven staan; die vallen hier niet onder.
SESSIE_BEWAARDAGEN=30

# Bewaartermijn voor inzendingen (persoonsgegevens) in dagen.
# Zie de privacyverklaring, hoofdstuk 7. Contactgegevens zonder vervolg of
# talentpool-toestemming: vier weken.
INZENDING_BEWAARDAGEN=28

# Bewaartermijn voor kandidaten die apart toestemming gaven voor de talentpool
# (bewaring in Jobylon voor toekomstige vacatures): twaalf maanden.
TALENTPOOL_BEWAARDAGEN=365

# Versiedatum van de privacyverklaring waarmee de kandidaat akkoord gaat.
# Houd dit gelijk aan de datum bovenaan public/privacyverklaring.html.
PRIVACY_VERSIE=2026-09-15

# Contactadres in de voettekst (klikbaar als mailto:)
CONTACT_EMAIL=werkenbij@aqua.nl
